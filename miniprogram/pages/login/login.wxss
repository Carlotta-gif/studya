page {
  min-height: 100vh;
  background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.login-box {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 48rpx;
  padding: 60rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.logo-wrapper {
  text-align: center;
  margin-bottom: 50rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(79, 70, 229, 0.3);
}

.logo-icon {
  font-size: 56rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.role-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 48rpx;
}

.role-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.role-tab.active {
  color: #fff;
}

.role-tab.active.manager {
  background: #4f46e5;
}

.role-tab.active.teacher {
  background: #059669;
}

.role-tab.active.student {
  background: #d97706;
}

.role-tab:not(.active) {
  color: #64748b;
}

.role-tab:not(.active):active {
  background: #e2e8f0;
}

.tab-icon {
  font-size: 28rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
}

.form-wrapper {
  margin-bottom: 36rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 32rpx;
  font-size: 32rpx;
  color: #1e293b;
  box-sizing: border-box;
  line-height: 1.5;
}

.form-input:focus {
  border-color: #4f46e5;
  background: #fff;
}

.login-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 16rpx;
}

.btn-icon {
  font-size: 24rpx;
}

.test-info {
  border-top: 2rpx solid #e2e8f0;
  padding-top: 24rpx;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.info-icon {
  font-size: 24rpx;
}

.arrow {
  margin-left: auto;
  font-size: 18rpx;
}

.info-content {
  margin-top: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
}

.info-item {
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 24rpx;
  font-family: monospace;
  background: #e0e7ff;
  color: #4f46e5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-list text {
  font-size: 22rpx;
  color: #475569;
  padding-left: 16rpx;
}
