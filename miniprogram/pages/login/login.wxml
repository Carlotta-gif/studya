<view class="container">
  <view class="login-box">
    <view class="logo-wrapper">
      <view class="logo">
        <text class="logo-icon">🎓</text>
      </view>
      <text class="title">COCO 留学管理后台</text>
      <text class="subtitle">请选择您的角色并登录系统</text>
    </view>

    <view class="role-tabs">
      <view 
        class="role-tab {{loginForm.role === 'manager' ? 'active manager' : ''}}"
        bindtap="switchRole"
        data-role="manager"
      >
        <text class="tab-icon">👔</text>
        <text class="tab-text">管理人</text>
      </view>
      <view 
        class="role-tab {{loginForm.role === 'teacher' ? 'active teacher' : ''}}"
        bindtap="switchRole"
        data-role="teacher"
      >
        <text class="tab-icon">👨‍🏫</text>
        <text class="tab-text">合作老师</text>
      </view>
      <view 
        class="role-tab {{loginForm.role === 'student' ? 'active student' : ''}}"
        bindtap="switchRole"
        data-role="student"
      >
        <text class="tab-icon">🎓</text>
        <text class="tab-text">学生</text>
      </view>
    </view>

    <view class="form-wrapper">
      <view class="form-item" wx:if="{{loginForm.role !== 'manager'}}">
        <text class="form-label">{{loginForm.role === 'teacher' ? '老师姓名' : '学生姓名'}}</text>
        <input 
          class="form-input" 
          placeholder="{{loginForm.role === 'teacher' ? '请输入您的老师姓名' : '请输入您的学生姓名'}}"
          value="{{loginForm.username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">登录密码 {{loginForm.role === 'manager' ? '(6位分配密码)' : ''}}</text>
        <input 
          class="form-input" 
          type="password"
          placeholder="请输入登录密码"
          value="{{loginForm.password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <button class="login-btn {{getRoleButtonColor()}}" bindtap="handleLogin">
        <text class="btn-icon">🔒</text>
        <text>确认安全登录</text>
      </button>
    </view>

    <view class="test-info">
      <view class="info-header" bindtap="toggleTestInfo">
        <text class="info-icon">💡</text>
        <text>快捷测试账号密码本</text>
        <text class="arrow">{{showTestInfo ? '▼' : '▲'}}</text>
      </view>
      <view class="info-content" wx:if="showTestInfo">
        <view class="info-item">
          <text class="info-label">🔑 工作室管理人:</text>
          <text class="info-value">密码 920101</text>
        </view>
        <view class="info-item">
          <text class="info-label">👨‍🏫 合作老师:</text>
          <view class="info-list">
            <text>王老师 | 密码: 111111</text>
            <text>李老师 | 密码: 222222</text>
          </view>
        </view>
        <view class="info-item">
          <text class="info-label">🎓 学生:</text>
          <view class="info-list">
            <text>张伟 | 密码: 888888</text>
            <text>李娜 | 密码: 999999</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>