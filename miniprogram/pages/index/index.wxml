<view class="container">
  <view class="header">
    <view class="header-left">
      <view class="logo">
        <text class="logo-icon">🎓</text>
      </view>
      <view class="header-info">
        <text class="header-title">COCO 留学管理后台</text>
        <text class="header-subtitle">申请进程与协作结算平台</text>
      </view>
    </view>
    <view class="header-right">
      <view class="user-info">
        <text class="user-role">{{roleName}}</text>
        <view class="user-actions">
          <text wx:if="{{currentRole === 'manager'}}" class="action-btn" bindtap="openManagerPwdModal">🔑 修改密码</text>
          <text class="action-btn logout" bindtap="handleLogout">🚪 退出</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-panel" wx:if="{{currentRole === 'manager'}}">
    <view class="stat-card">
      <view class="stat-icon users">👥</view>
      <view class="stat-content">
        <text class="stat-label">在管学生人数</text>
        <text class="stat-value">{{uniqueStudentsCount}}</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon urgent">🔥</view>
      <view class="stat-content">
        <text class="stat-label">紧急跟踪项目</text>
        <text class="stat-value urgent">{{urgentProjectsCount}}</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon progress">✅</view>
      <view class="stat-content">
        <text class="stat-label">文书交付进度</text>
        <text class="stat-value success">{{deliveryProgress}}</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon wallet">💰</view>
      <view class="stat-content">
        <text class="stat-label">应付老师总额</text>
        <text class="stat-value primary">¥{{totalSettlement}}</text>
      </view>
    </view>
  </view>

  <view class="filter-panel">
    <view class="filter-header">
      <text class="filter-title">📊 申请看板条件筛选器</text>
      <text class="filter-reset" bindtap="resetFilters">🔄 重置筛选</text>
    </view>
    <view class="filter-row">
      <view class="filter-item">
        <text class="filter-label">学生姓名</text>
        <input 
          class="filter-input" 
          placeholder="输入学生姓名"
          value="{{filters.studentName}}"
          bindinput="onStudentNameInput"
          disabled="{{currentRole === 'student'}}"
        />
      </view>
      <view class="filter-item">
        <text class="filter-label">目标院校项目</text>
        <input 
          class="filter-input" 
          placeholder="搜索学校/项目"
          value="{{filters.projectName}}"
          bindinput="onProjectNameInput"
        />
      </view>
    </view>
    <view class="filter-row">
      <view class="filter-item">
        <text class="filter-label">截止日期不晚于</text>
        <picker mode="date" bindchange="onDdlMaxChange">
          <view class="filter-input">{{filters.ddlMax || '选择日期'}}</view>
        </picker>
      </view>
      <view class="filter-item">
        <text class="filter-label">剩余天数 ≤ {{filters.daysLeftMax || '∞'}}</text>
        <slider 
          class="filter-slider"
          min="1" 
          max="60" 
          value="{{filters.daysLeftMax || 30}}"
          bindchange="onDaysLeftMaxChange"
        />
      </view>
    </view>
    <view class="filter-row" wx:if="{{currentRole !== 'teacher'}}">
      <view class="filter-item">
        <text class="filter-label">主导/负责老师</text>
        <input 
          class="filter-input" 
          placeholder="输入老师姓名筛选"
          value="{{filters.teacherName}}"
          bindinput="onTeacherNameInput"
          disabled="{{currentRole === 'teacher'}}"
        />
      </view>
    </view>
  </view>

  <view class="table-container">
    <view class="table-header">
      <text class="th">学生姓名</text>
      <text class="th">申请项目</text>
      <text class="th">截止日期</text>
      <text class="th">状态</text>
      <text class="th">任务协作</text>
    </view>
    <view class="table-body">
      <view class="table-row" wx:for="{{filteredList}}" wx:key="id">
        <view class="td">
          <view class="student-info">
            <view class="student-avatar {{item.urgent ? 'urgent' : ''}}">
              {{item.studentName.charAt(0)}}
            </view>
            <text class="student-name">{{item.studentName}}</text>
          </view>
        </view>
        <view class="td">
          <text class="project-name">{{item.projectName}}</text>
          <view class="project-actions" wx:if="{{currentRole === 'manager'}}">
            <text class="action" bindtap="openProjectEditModal" data-id="{{item.id}}">✏️</text>
            <text class="action delete" bindtap="deleteProject" data-id="{{item.id}}">🗑️</text>
          </view>
        </view>
        <view class="td">
          <text class="ddl">{{item.ddl}}</text>
        </view>
        <view class="td">
          <view class="status-tag {{item.urgent ? 'urgent' : ''}}">
            {{item.urgent ? '🚨紧急' : '正常'}}
          </view>
          <text class="days-left">剩 {{item.days}} 天</text>
        </view>
        <view class="td">
          <view class="tasks-wrapper">
            <view class="task-item" wx:for="{{item.tasks}}" wx:key="id" wx:for-item="task">
              <view class="task-header">
                <view class="task-type {{task.typeClass}}">
                  {{task.type}}
                </view>
                <view class="task-teacher-wrapper">
                  <picker 
                    wx:if="{{currentRole === 'manager'}}"
                    mode="selector"
                    range="{{teacherNames}}"
                    bindchange="updateTeacher"
                    data-app-id="{{item.id}}"
                    data-task-id="{{task.id}}"
                  >
                    <view class="task-teacher picker">👤 {{task.teacher || '待分配'}} ▼</view>
                  </picker>
                  <text wx:else class="task-teacher">👤 {{task.teacher || '待分配'}}</text>
                </view>
              </view>
              <view class="task-body">
                <view wx:if="{{task.fileUrl}}" class="task-file-wrapper">
                  <text class="task-file">{{task.fileName}}</text>
                  <text class="preview-btn" bindtap="previewFile" data-url="{{task.fileUrl}}" data-name="{{task.fileName}}">👁️ 预览</text>
                </view>
                <text wx:else class="task-empty">📄 待上传</text>
                <view class="task-actions" wx:if="{{currentRole === 'manager' || (currentRole === 'teacher' && task.teacher === loggedInUser.name)}}">
                  <button 
                    class="upload-btn" 
                    bindtap="uploadFile" 
                    data-app-id="{{item.id}}"
                    data-task-id="{{task.id}}"
                  >
                    {{task.fileUrl ? '🔄更新' : '📤上传PDF'}}
                  </button>
                </view>
              </view>
              <view class="task-settlement" wx:if="{{currentRole === 'manager' || (currentRole === 'teacher' && task.teacher === loggedInUser.name)}}">
                  <view class="settlement-amount-wrapper">
                    <text class="settlement-label">💰 费用:</text>
                    <input 
                      wx:if="{{currentRole === 'manager'}}"
                      class="settlement-input"
                      type="digit"
                      value="{{task.settlement}}"
                      bindblur="updateSettlement"
                      data-app-id="{{item.id}}"
                      data-task-id="{{task.id}}"
                    />
                    <text wx:else class="settlement-amount">¥{{task.settlement}}</text>
                  </view>
                  <view class="settlement-status">
                    <picker 
                      wx:if="{{currentRole === 'manager'}}"
                      mode="selector"
                      range="{{['未结算', '已结算']}}"
                      bindchange="toggleSettlement"
                      data-app-id="{{item.id}}"
                      data-task-id="{{task.id}}"
                    >
                      <view class="settlement-picker {{task.isSettled ? 'settled' : 'unsettled'}}">
                        {{task.isSettled ? '✅已结' : '🔄未结'}} ▼
                      </view>
                    </picker>
                    <text wx:else class="{{task.isSettled ? 'settled' : 'unsettled'}}">{{task.isSettled ? '✅已结' : '🔄未结'}}</text>
                  </view>
                  <view class="voucher-section" wx:if="{{currentRole === 'manager'}}">
                    <view wx:if="{{task.voucherUrl}}" class="voucher-view">
                      <text class="voucher-label">📷 凭证:</text>
                      <image 
                        class="voucher-image" 
                        src="{{task.voucherUrl}}" 
                        mode="aspectFill"
                        bindtap="previewVoucher"
                        data-url="{{task.voucherUrl}}"
                      />
                      <text class="voucher-clear" bindtap="clearVoucher" data-app-id="{{item.id}}" data-task-id="{{task.id}}">🗑️</text>
                    </view>
                    <button 
                      wx:else
                      class="voucher-upload-btn"
                      bindtap="uploadVoucher"
                      data-app-id="{{item.id}}"
                      data-task-id="{{task.id}}"
                    >
                      📷 上传凭证
                    </button>
                  </view>
                </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="filteredList.length === 0">
      <view class="empty-icon">📁</view>
      <text class="empty-text">此视图下暂无匹配的项目进程数据</text>
    </view>
  </view>

  <view class="manager-section" wx:if="currentRole === 'manager'">
    <view class="summary-section">
      <view class="section-header">
        <text class="section-title">🧮 合作老师费用结算汇总清单</text>
        <text class="section-subtitle">系统根据已登记老师与金额自动汇总统计</text>
      </view>
      <view class="summary-grid">
        <view class="summary-card" wx:for="{{teacherSettlementSummaries}}" wx:key="teacher">
          <view class="summary-header">
            <text class="summary-teacher">{{item.teacher}}</text>
            <text class="summary-count">指派任务数: {{item.count}}</text>
          </view>
          <view class="summary-body">
            <text class="summary-label">待结算 / 已支付</text>
            <view class="summary-amount">
              <text class="summary-total">¥{{item.total}}</text>
              <text class="summary-settled">已结: ¥{{item.settledTotal}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="teacher-roster">
      <view class="section-header">
        <text class="section-title">📋 合作老师账户与凭证名册</text>
        <text class="section-action" bindtap="openTeacherModal">⚙️ 管理</text>
      </view>
      <view class="roster-list">
        <view class="roster-item" wx:for="{{teachers}}" wx:key="id">
          <view class="roster-info">
            <text class="roster-name">{{item.name}}</text>
            <text class="roster-id">ID: {{item.id}}</text>
          </view>
          <view class="roster-password">
            <text class="password-label">密码: </text>
            <text class="password-value">{{item.password}}</text>
          </view>
        </view>
      </view>
      <view class="roster-note">
        说明：管理人可在名册中为合作老师分配、重置密码。登录系统后，老师们只能操作属于自己的文书任务并隐匿结算金额。
      </view>
    </view>
  </view>

  <view class="footer-actions" wx:if="currentRole === 'manager'">
    <button class="action-btn" bindtap="openStudentModal">👥 管理学生</button>
    <button class="action-btn" bindtap="openTeacherModal">👨‍🏫 管理老师</button>
    <button class="action-btn primary" bindtap="openProjectModal">➕ 新建项目</button>
  </view>

  <view class="modal-overlay" wx:if="{{isModalOpen}}" bindtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{modalTitle}}</text>
        <text class="modal-close" bindtap="closeModal">✕</text>
      </view>
      <view class="modal-body">
        <view wx:if="{{modalType === 'student'}}">
          <view class="form-group">
            <text class="form-label">学生姓名 *</text>
            <input class="form-input" placeholder="请输入学生姓名" value="{{formData.name}}" bindinput="onFormNameInput" />
          </view>
          <view class="form-group">
            <text class="form-label">6位数字密码 *</text>
            <input class="form-input" placeholder="请输入6位密码" value="{{formData.password}}" bindinput="onFormPasswordInput" />
            <text class="generate-btn" bindtap="generatePassword">🔀 随机生成</text>
          </view>
          <view class="modal-list">
            <text class="list-title">已登记学生</text>
            <view class="list-item" wx:for="{{students}}" wx:key="id">
              <text class="list-name">{{item.name}}</text>
              <view class="list-actions">
                <text class="list-action" bindtap="editStudent" data-id="{{item.id}}">✏️</text>
                <text class="list-action delete" bindtap="removeStudent" data-id="{{item.id}}">🗑️</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{modalType === 'teacher'}}">
          <view class="form-group">
            <text class="form-label">老师姓名 *</text>
            <input class="form-input" placeholder="请输入老师姓名" value="{{formData.name}}" bindinput="onFormNameInput" />
          </view>
          <view class="form-group">
            <text class="form-label">6位数字密码 *</text>
            <input class="form-input" placeholder="请输入6位密码" value="{{formData.password}}" bindinput="onFormPasswordInput" />
            <text class="generate-btn" bindtap="generatePassword">🔀 随机生成</text>
          </view>
          <view class="modal-list">
            <text class="list-title">已登记老师</text>
            <view class="list-item" wx:for="{{teachers}}" wx:key="id">
              <text class="list-name">{{item.name}}</text>
              <view class="list-actions">
                <text class="list-action" bindtap="editTeacher" data-id="{{item.id}}">✏️</text>
                <text class="list-action delete" bindtap="removeTeacher" data-id="{{item.id}}">🗑️</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{modalType === 'project'}}">
          <view class="form-group">
            <text class="form-label">选择学生 *</text>
            <picker value="{{formData.studentIndex}}" range="{{studentNames}}" bindchange="onStudentChange">
              <view class="form-input">{{studentNames[formData.studentIndex] || '请选择学生'}}</view>
            </picker>
          </view>
          <view class="form-group">
            <text class="form-label">项目名称 *</text>
            <input class="form-input" placeholder="例如：香港大学 - 金融学硕士" value="{{formData.projectName}}" bindinput="onProjectNameInputModal" />
          </view>
          <view class="form-group">
            <text class="form-label">截止日期 *</text>
            <picker mode="date" bindchange="onDdlChange">
              <view class="form-input">{{formData.ddl || '选择日期'}}</view>
            </picker>
          </view>
        </view>
        <view wx:if="{{modalType === 'managerPwd'}}">
          <view class="form-group">
            <text class="form-label">当前密码 *</text>
            <input class="form-input" type="password" placeholder="请输入当前密码" value="{{formData.current}}" bindinput="onCurrentPwdInput" />
          </view>
          <view class="form-group">
            <text class="form-label">新密码 *</text>
            <input class="form-input" type="password" placeholder="请输入新密码" value="{{formData.new}}" bindinput="onNewPwdInput" />
          </view>
          <view class="form-group">
            <text class="form-label">确认新密码 *</text>
            <input class="form-input" type="password" placeholder="请再次输入新密码" value="{{formData.confirm}}" bindinput="onConfirmPwdInput" />
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="closeModal">取消</button>
        <button class="modal-btn confirm" bindtap="saveForm">{{isEditing ? '保存更新' : '确认创建'}}</button>
      </view>
    </view>
  </view>
</view>