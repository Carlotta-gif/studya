page {
  background: #f1f5f9;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo {
  width: 80rpx;
  height: 80rpx;
  background: #4f46e5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  font-size: 40rpx;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
}

.header-subtitle {
  font-size: 20rpx;
  color: #94a3b8;
}

.header-right {
  display: flex;
  align-items: center;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.user-role {
  font-size: 26rpx;
  font-weight: 600;
  color: #a5b4fc;
}

.user-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.action-btn {
  font-size: 22rpx;
  color: #94a3b8;
}

.action-btn.logout {
  color: #f87171;
}

.stats-panel {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 30rpx;
}

.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.stat-icon.users {
  background: #dbeafe;
}

.stat-icon.urgent {
  background: #fee2e2;
}

.stat-icon.progress {
  background: #dcfce7;
}

.stat-icon.wallet {
  background: #ede9fe;
}

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e293b;
}

.stat-value.urgent {
  color: #dc2626;
}

.stat-value.success {
  color: #059669;
}

.stat-value.primary {
  color: #4f46e5;
}

.filter-panel {
  margin: 0 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.filter-reset {
  font-size: 22rpx;
  color: #4f46e5;
}

.filter-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  min-width: 0;
}

.filter-label {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.filter-input {
  width: 100%;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #1e293b;
  line-height: 1.5;
}

.filter-slider {
  width: 100%;
  margin-top: 12rpx;
}

.table-container {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.table-header {
  display: flex;
  background: #f8fafc;
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid #e2e8f0;
}

.th {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
}

.table-body {
  max-height: 600rpx;
  overflow-y: auto;
}

.table-row {
  display: flex;
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  flex: 1;
  font-size: 22rpx;
  color: #334155;
}

.student-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.student-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #64748b;
}

.student-avatar.urgent {
  background: #fecaca;
  color: #dc2626;
}

.student-name {
  font-weight: 600;
}

.project-name {
  font-size: 20rpx;
  display: block;
  margin-bottom: 8rpx;
}

.project-actions {
  display: flex;
  gap: 16rpx;
}

.action {
  font-size: 24rpx;
}

.action.delete {
  color: #ef4444;
}

.ddl {
  font-family: monospace;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #e2e8f0;
  color: #64748b;
}

.status-tag.urgent {
  background: #fee2e2;
  color: #dc2626;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.days-left {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.tasks-wrapper {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-item {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.task-type {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.task-type.PS {
  background: #e0e7ff;
  color: #4f46e5;
}

.task-type.RL {
  background: #e0f2fe;
  color: #0369a1;
}

.task-type.CV {
  background: #dcfce7;
  color: #059669;
}

.task-teacher {
  font-size: 18rpx;
  color: #64748b;
}

.task-teacher-wrapper {
  display: flex;
  align-items: center;
}

.task-teacher.picker {
  cursor: pointer;
}

.task-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-file {
  font-size: 18rpx;
  color: #4f46e5;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-file-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.preview-btn {
  font-size: 18rpx;
  color: #4f46e5;
  padding: 4rpx 12rpx;
  background: #e0e7ff;
  border-radius: 8rpx;
  cursor: pointer;
}

.task-empty {
  font-size: 18rpx;
  color: #94a3b8;
}

.upload-btn {
  font-size: 24rpx;
}

.task-settlement {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.settlement-amount {
  font-size: 20rpx;
  color: #4f46e5;
  font-weight: 600;
}

.settlement-status text {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f1f5f9;
  color: #64748b;
}

.settlement-status .settled {
  background: #dcfce7;
  color: #059669;
}

.settlement-input {
  width: 120rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  text-align: right;
  color: #1e293b;
}

.settlement-picker {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  cursor: pointer;
}

.voucher-section {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #f1f5f9;
}

.voucher-view {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voucher-label {
  font-size: 18rpx;
  color: #64748b;
}

.voucher-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e2e8f0;
}

.voucher-clear {
  font-size: 24rpx;
  color: #ef4444;
  cursor: pointer;
}

.voucher-upload-btn {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 8rpx;
  border: 2rpx solid #e2e8f0;
}

.manager-section {
  margin: 30rpx;
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20rpx;
}

.summary-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1e293b;
}

.section-subtitle {
  font-size: 20rpx;
  color: #64748b;
}

.section-action {
  font-size: 22rpx;
  color: #4f46e5;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.summary-card {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.summary-teacher {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
}

.summary-count {
  font-size: 20rpx;
  background: #e0e7ff;
  color: #4f46e5;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.summary-body {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.summary-label {
  font-size: 20rpx;
  color: #64748b;
}

.summary-amount {
  text-align: right;
}

.summary-total {
  font-size: 32rpx;
  font-weight: bold;
  font-family: monospace;
  color: #4f46e5;
  display: block;
}

.summary-settled {
  font-size: 18rpx;
  color: #94a3b8;
  display: block;
}

.teacher-roster {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}

.roster-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.roster-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
}

.roster-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.roster-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
}

.roster-id {
  font-size: 18rpx;
  color: #94a3b8;
}

.roster-password {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.password-label {
  font-size: 18rpx;
  color: #64748b;
}

.password-value {
  font-size: 20rpx;
  font-family: monospace;
  font-weight: 600;
  background: #e0e7ff;
  color: #4f46e5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.roster-note {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f5f9;
  font-size: 18rpx;
  color: #64748b;
  line-height: 1.6;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  margin: 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
}

.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.footer-actions .action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #f1f5f9;
  color: #475569;
}

.footer-actions .action-btn.primary {
  background: #4f46e5;
  color: #fff;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 30rpx;
}

.modal-content {
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  color: #1e293b;
  line-height: 1.5;
}

.generate-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #4f46e5;
  margin-top: 8rpx;
}

.modal-list {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f1f5f9;
}

.list-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 16rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.list-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.list-actions {
  display: flex;
  gap: 16rpx;
}

.list-action {
  font-size: 24rpx;
}

.list-action.delete {
  color: #ef4444;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  border-top: 2rpx solid #f1f5f9;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #f1f5f9;
  color: #64748b;
}

.modal-btn.confirm {
  background: #4f46e5;
  color: #fff;
}
